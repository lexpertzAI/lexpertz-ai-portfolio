{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-flash",
  "default_agent": "build",
  "agents": {
    "title": {
      "model": "deepseek/deepseek-v4-flash"
    }
  },
  "skills": ["skills"],
  "permissions": [
    {
      "action": "context7_*",
      "resource": "*",
      "effect": "ask"
    }
  ],
  "mcp": {
    "servers": {
      "shadcn": {
        "type": "local",
        "command": ["npx", "-y", "shadcn@latest", "mcp"],
        "disabled": true
      }
    }
  }
}
